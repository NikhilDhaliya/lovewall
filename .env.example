# Lovewall configuration. Copy to .env (Docker) or .env.local (pnpm dev) and fill in.

# ---------- App ----------
# Public URL of this deployment, no trailing slash. Used in links, emails, embeds and auth.
APP_URL=http://localhost:3000
# Secret for sessions and signed tokens. Generate one: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# ---------- Database (Postgres; Supabase works as plain Postgres) ----------
# Supabase: use the pooled connection string (Transaction pooler, port 6543) from Project settings > Database.
DATABASE_URL=postgresql://lovewall:lovewall@localhost:5432/lovewall
# Max connections per server instance (keep small on serverless).
DATABASE_POOL_MAX=5

# ---------- Email (sign-in codes and notifications) ----------
# zeptomail | smtp | log. Leave empty to pick automatically: ZeptoMail if its key is set, else SMTP if SMTP_HOST is
# set, else "log" (codes are printed to the server log; fine for a first local run).
MAIL_DRIVER=
# Sender, as "Name <address>". The domain must be verified with your provider.
MAIL_FROM=Lovewall <hello@example.com>
# ZeptoMail (transactional mail API). Send Mail Token from your Mail Agent.
ZEPTOMAIL_API_KEY=
# Region endpoint: https://api.zeptomail.com/v1.1/email (default), .in / .eu / .com.au for other data centres.
ZEPTOMAIL_URL=
# SMTP (any provider: Postmark, SES, Resend, Mailgun, Gmail...).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true for implicit TLS (usually port 465). Defaults to true only on 465.
SMTP_SECURE=

# ---------- File storage (photos, logos, videos) ----------
# Any S3-compatible store: Supabase Storage (S3 API), Cloudflare R2, AWS S3, RustFS, MinIO. The bucket stays private.
# Without these, Lovewall still works but photo and video uploads are off.
S3_ENDPOINT=http://localhost:9000
# Optional: the endpoint browsers use, when it differs from the one the server uses (Docker: http://localhost:9000).
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=lovewall
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for RustFS, MinIO and Supabase; false for AWS S3 and R2.
S3_FORCE_PATH_STYLE=true

# ---------- Sign in with GitHub / Google (optional; buttons appear only when both values are set) ----------
# Callback URL: <APP_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Callback URL: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Imports (optional; each source shows only when its key is set) ----------
# Google reviews: a Places API (New) key from Google Cloud. Google returns at most 5 reviews per place.
GOOGLE_PLACES_API_KEY=
# Yelp reviews: a Yelp Fusion API key (yelp.com/developers).
YELP_API_KEY=
# YouTube comments: a YouTube Data API v3 key. Video links import without it.
YOUTUBE_API_KEY=

# ---------- Client IP (rate limits) ----------
# Set to 1 only when a reverse proxy (nginx, Caddy, a load balancer) in front of Lovewall sets X-Real-IP or
# X-Forwarded-For. Without a proxy those headers can be forged, so leave it empty: `pnpm start` and the Docker image
# then use the connection's own address. On Vercel the platform's header is used automatically.
TRUST_PROXY=
# Requests one IP may make per minute to one server instance before it gets 429s (default 1200, 0 = off).
RATE_LIMIT_PER_MINUTE=

# ---------- Background jobs ----------
# Protects /api/cron/maintenance (mail and webhook retries, cleanup). Vercel Cron sends it automatically. Run it every
# few minutes when you can: webhook retries wait for it.
CRON_SECRET=replace-with-another-random-string

# ---------- Legal pages (/legal: terms, privacy, DPA...) ----------
# Shown automatically on the hosted service (APP_URL on lovewall.tech). Self-hosters: you are the operator of your
# instance; edit src/lib/legal/config.ts with your own name and addresses, then set this to true to show the pages.
LEGAL_PAGES=

# ---------- Webhooks ----------
# Set to 1 to let webhooks, Slack/Discord links and REST Hooks reach private addresses and plain http (endpoints on
# your own network, e.g. n8n on the LAN). Leave empty on a public service: it is what blocks SSRF.
WEBHOOKS_ALLOW_PRIVATE=

# ---------- Limits (hosted service defaults; raise them when self-hosting) ----------
MAX_SPACES_PER_USER=10
MAX_WIDGETS_PER_SPACE=30
MAX_SUBMISSIONS_PER_SPACE_PER_DAY=300
MAX_VIDEO_MB=60
# People per space (members plus pending invites).
MAX_MEMBERS_PER_SPACE=25

# ---------- Hosted billing (Polar; leave empty when self-hosting) ----------
# Without POLAR_ACCESS_TOKEN there is no billing at all: no plans, no trial, nothing locked.
# Organization access token (Polar > Settings > Developers). Sandbox and production tokens are separate.
POLAR_ACCESS_TOKEN=
# Webhook signing secret from Polar > Settings > Webhooks (endpoint <APP_URL>/api/billing/webhook).
POLAR_WEBHOOK_SECRET=
# sandbox or production (default).
POLAR_SERVER=production
# Product ids of the two hosted plans: $9 a month and $90 a year (recurring).
POLAR_PRODUCT_MONTHLY=
POLAR_PRODUCT_YEARLY=

# Invite emails (and reminders) a space can send per 24 hours.
MAX_INVITES_PER_SPACE_PER_DAY=200

# ---------- Custom domains (love.acme.com for a space's forms and wall pages) ----------
# The host customers point their CNAME at. Default: the host of APP_URL. On Vercel: cname.vercel-dns.com
CUSTOM_DOMAIN_TARGET=
# Hosted on Vercel: a token and the project id, so new domains are added to the project (and get TLS) automatically.
# Leave empty when self-hosting: point DNS at your server and let your reverse proxy handle TLS.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
# Only when the project belongs to a Vercel team.
VERCEL_TEAM_ID=

# ---------- AI (optional; every AI feature is hidden without its key) ----------
# Claude (console.anthropic.com > API keys): spam filter, sentiment, best line, summaries, spelling help on forms,
# translations, case studies, forms from a website, reading screenshots.
ANTHROPIC_API_KEY=
# Model overrides (defaults: claude-haiku-5-5 for quick jobs, claude-opus-5-5 for writing).
AI_MODEL_FAST=
AI_MODEL_WRITE=
# Deepgram (console.deepgram.com, free credit to start): transcripts and captions for video testimonials.
DEEPGRAM_API_KEY=
# AI calls a space can make per day, all features together (each feature also has its own daily cap).
AI_MAX_CALLS_PER_SPACE_PER_DAY=1000

# ---------- Testing only ----------
# Point X imports at a mock server (end-to-end tests). Leave empty in production.
X_OEMBED_ENDPOINT=
X_SYNDICATION_ENDPOINT=
# Point the Polar client at a mock API (end-to-end tests). Leave empty in production.
POLAR_API_URL=
# Custom-domain checks against mocks: a DNS-over-HTTPS JSON endpoint instead of the system resolver, and the Vercel API.
DNS_OVER_HTTPS_URL=
VERCEL_API_URL=
# Send every import request (reviews, mentions, media) to this server instead (end-to-end tests).
IMPORT_TEST_ENDPOINT=
# Point the Anthropic SDK and the speech-to-text client at mocks (end-to-end tests). Leave empty in production.
ANTHROPIC_BASE_URL=
DEEPGRAM_API_URL=
