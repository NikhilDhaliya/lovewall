{
  "name": "lovewall",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source testimonials: collect them with one link and show a wall of love on your site.",
  "license": "AGPL-3.0-only",
  "author": "Nikhil Dhaliya",
  "repository": {
    "type": "git",
    "url": "https://github.com/NikhilDhaliya/lovewall"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node --require ./scripts/client-ip.cjs ./node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs",
    "build:e2e": "APP_URL=http://localhost:${E2E_PORT:-3111} LEGAL_PAGES=true next build",
    "test:e2e": "playwright test",
    "storage:setup": "node scripts/setup-storage.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "extension:zip": "node scripts/extension-zip.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@polar-sh/sdk": "^1.0.2",
    "better-auth": "^1.7.13",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "16.4.3",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20.9"
  }
}
