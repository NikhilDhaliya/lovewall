{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "lovewall/widget",
  "version": "0.1.0",
  "title": "Lovewall",
  "category": "widgets",
  "icon": "heart",
  "description": "Show a Lovewall widget: a wall of love, carousel, marquee or badge.",
  "keywords": ["testimonials", "reviews", "wall of love"],
  "textdomain": "lovewall",
  "attributes": {
    "widgetId": { "type": "string", "default": "" }
  },
  "supports": {
    "html": false,
    "align": ["wide", "full"]
  },
  "editorScript": "file:./index.js"
}
